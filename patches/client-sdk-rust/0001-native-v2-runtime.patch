+//! Fixed decoded ingress for native playout. No Tokio task, FFI event queue,
+//! per-frame allocation, receiver waker, or waiting lock in this handoff.
+
+use std::{
+    cell::UnsafeCell,
+    ops::{Deref, DerefMut},
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        Arc,
+    },
+    time::{Duration, Instant},
+};
+
+use cxx::SharedPtr;
+use webrtc_sys::audio_track as sys_at;
+
+use crate::audio_track::RtcAudioTrack;
+
+/// Samples in one interleaved 48 kHz stereo/10 ms frame.
+pub const FRESH_AUDIO_SAMPLES: usize = 960;
+/// Hard number of retained decoded frames per sink.
+pub const FRESH_AUDIO_CAPACITY: usize = 4;
+
+/// Owned fixed PCM and the monotonic instant preceding its ingress copy.
+#[derive(Clone, Copy)]
+pub struct FreshAudioFrame {
+    pub samples: [i16; FRESH_AUDIO_SAMPLES],
+    pub decoded_at: Instant,
+    pub sequence: u64,
+    pub discontinuity: bool,
+}
+
+/// Bounded ingress counters; no sample-level telemetry callback is emitted.
+#[derive(Clone, Copy, Default)]
+pub struct FreshAudioStats {
+    pub received: u64,
+    pub dropped: u64,
+    pub stale: u64,
+    pub invalid: u64,
+    pub queued: u64,
+}
+
+struct QueueState {
+    frames: [Option<FreshAudioFrame>; FRESH_AUDIO_CAPACITY],
+    head: usize,
+    depth: usize,
+    consumed_sequence: u64,
+}
+
+struct FreshAudioQueue {
+    state: UnsafeCell<QueueState>,
+    busy: AtomicBool,
+    closed: AtomicBool,
+    received: AtomicU64,
+    dropped: AtomicU64,
+    stale: AtomicU64,
+    invalid: AtomicU64,
+    queued: AtomicU64,
+}
+
+// SAFETY: Every access to state requires the single successful acquire CAS in
+// try_state. QueueGuard exclusively borrows it until its release store. No
+// reference into state escapes a guard; frames are copied out as owned values.
+unsafe impl Sync for FreshAudioQueue {}
+
+struct QueueGuard<'a>(&'a FreshAudioQueue);
+
+impl Deref for QueueGuard<'_> {
+    type Target = QueueState;
+    fn deref(&self) -> &Self::Target {
+        // SAFETY: This guard owns the queue's one state access permit.
+        unsafe { &*self.0.state.get() }
+    }
+}
+
+impl DerefMut for QueueGuard<'_> {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        // SAFETY: This unique guard owns the queue's one state access permit.
+        unsafe { &mut *self.0.state.get() }
+    }
+}
+
+impl Drop for QueueGuard<'_> {
+    fn drop(&mut self) {
+        self.0.busy.store(false, Ordering::Release);
+    }
+}
+
+impl FreshAudioQueue {
+    fn new() -> Self {
+        Self {
+            state: UnsafeCell::new(QueueState {
+                frames: [None; FRESH_AUDIO_CAPACITY],
+                head: 0,
+                depth: 0,
+                consumed_sequence: 0,
+            }),
+            busy: AtomicBool::new(false),
+            closed: AtomicBool::new(false),
+            received: AtomicU64::new(0),
+            dropped: AtomicU64::new(0),
+            stale: AtomicU64::new(0),
+            invalid: AtomicU64::new(0),
+            queued: AtomicU64::new(0),
+        }
+    }
+
+    fn try_state(&self) -> Option<QueueGuard<'_>> {
+        self.busy
+            .compare_exchange(false, true, Ordering::Acquire, Ordering::Relaxed)
+            .ok()
+            .map(|_| QueueGuard(self))
+    }
+
+    fn push(&self, data: &[i16], decoded_at: Instant) {
+        if self.closed.load(Ordering::Acquire) {
+            return;
+        }
+        if data.len() != FRESH_AUDIO_SAMPLES {
+            self.invalid.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+        let sequence = self.received.fetch_add(1, Ordering::Relaxed) + 1;
+        let Some(mut state) = self.try_state() else {
+            self.dropped.fetch_add(1, Ordering::Relaxed);
+            return;
+        };
+        if self.closed.load(Ordering::Acquire) {
+            return;
+        }
+        if state.depth == FRESH_AUDIO_CAPACITY {
+            state.head = (state.head + 1) % FRESH_AUDIO_CAPACITY;
+            state.depth -= 1;
+            self.dropped.fetch_add(1, Ordering::Relaxed);
+        }
+        let mut frame = FreshAudioFrame {
+            samples: [0; FRESH_AUDIO_SAMPLES],
+            decoded_at,
+            sequence,
+            discontinuity: false,
+        };
+        frame.samples.copy_from_slice(data);
+        let index = (state.head + state.depth) % FRESH_AUDIO_CAPACITY;
+        state.frames[index] = Some(frame);
+        state.depth += 1;
+        self.queued.store(state.depth as u64, Ordering::Relaxed);
+    }
+
+    fn take(&self, now: Instant, maximum_age: Duration) -> Option<FreshAudioFrame> {
+        if self.closed.load(Ordering::Acquire) {
+            return None;
+        }
+        let mut state = self.try_state()?;
+        for _ in 0..FRESH_AUDIO_CAPACITY {
+            if state.depth == 0 {
+                break;
+            }
+            let index = state.head;
+            let frame = state.frames[index].take();
+            state.head = (state.head + 1) % FRESH_AUDIO_CAPACITY;
+            state.depth -= 1;
+            self.queued.store(state.depth as u64, Ordering::Relaxed);
+            if let Some(mut frame) = frame {
+                if now < frame.decoded_at || now.duration_since(frame.decoded_at) > maximum_age {
+                    self.stale.fetch_add(1, Ordering::Relaxed);
+                    continue;
+                }
+                frame.discontinuity = frame.sequence != state.consumed_sequence + 1;
+                state.consumed_sequence = frame.sequence;
+                return Some(frame);
+            }
+        }
+        None
+    }
+
+    fn stats(&self) -> FreshAudioStats {
+        FreshAudioStats {
+            received: self.received.load(Ordering::Relaxed),
+            dropped: self.dropped.load(Ordering::Relaxed),
+            stale: self.stale.load(Ordering::Relaxed),
+            invalid: self.invalid.load(Ordering::Relaxed),
+            queued: if self.closed.load(Ordering::Acquire) {
+                0
+            } else {
+                self.queued.load(Ordering::Relaxed)
+            },
+        }
+    }
+}
+
+impl sys_at::AudioSink for FreshAudioQueue {
+    fn on_data(&self, data: &[i16], sample_rate: i32, channels: usize, frames: usize) {
+        self.on_data_with_age(data, sample_rate, channels, frames, 0);
+    }
+
+    fn on_data_with_age(
+        &self,
+        data: &[i16],
+        sample_rate: i32,
+        channels: usize,
+        frames: usize,
+        processing_age_us: u64,
+    ) {
+        // Translate elapsed time rather than assuming C++ and Rust Instant
+        // share an epoch. The native age includes format conversion/scheduling.
+        let Some(decoded_at) = Instant::now().checked_sub(Duration::from_micros(processing_age_us))
+        else {
+            self.invalid.fetch_add(1, Ordering::Relaxed);
+            return;
+        };
+        if sample_rate != 48_000 || channels != 2 || frames != 480 {
+            self.invalid.fetch_add(1, Ordering::Relaxed);
+            return;
+        }
+        self.push(data, decoded_at);
+    }
+}
+
+/// One track-bound native sink. Create/read/close on one owner; WebRTC owns the
+/// producer callback. Stop this stream before closing its Room/runtime.
+pub struct FreshAudioStream {
+    sink: SharedPtr<sys_at::ffi::NativeAudioSink>,
+    track: RtcAudioTrack,
+    queue: Arc<FreshAudioQueue>,
+    closed: bool,
+}
+
+impl FreshAudioStream {
+    /// Attach one converted 48 kHz stereo native sink to the audio track.
+    pub fn new(track: RtcAudioTrack) -> Self {
+        let queue = Arc::new(FreshAudioQueue::new());
+        let sink = sys_at::ffi::new_native_audio_sink(
+            Box::new(sys_at::AudioSinkWrapper::new(queue.clone())),
+            48_000,
+            2,
+        );
+        // SAFETY: RtcAudioTrack guarantees that this handle is an audio track.
+        let audio = unsafe { sys_at::ffi::media_to_audio(track.sys_handle()) };
+        audio.add_sink(&sink);
+        Self { sink, track, queue, closed: false }
+    }
+
+    /// Copy one fresh frame without waiting; discard expired queued values.
+    pub fn try_read(&self, maximum_age: Duration) -> Option<FreshAudioFrame> {
+        self.queue.take(Instant::now(), maximum_age)
+    }
+
+    /// Snapshot counters without entering the PCM critical section.
+    pub fn stats(&self) -> FreshAudioStats {
+        self.queue.stats()
+    }
+
+    /// Retire ingress before removing the native sink; repeated close is safe.
+    pub fn close(&mut self) {
+        if self.closed {
+            return;
+        }
+        self.closed = true;
+        self.queue.closed.store(true, Ordering::Release);
+        // SAFETY: The retained typed track keeps its native audio handle live.
+        let audio = unsafe { sys_at::ffi::media_to_audio(self.track.sys_handle()) };
+        audio.remove_sink(&self.sink);
+    }
+}
+
+impl Drop for FreshAudioStream {
+    fn drop(&mut self) {
+        self.close();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn overrun_stale_and_retirement() {
+        let queue = FreshAudioQueue::new();
+        let now = Instant::now();
+        for index in 0..10 {
+            queue.push(&[index; FRESH_AUDIO_SAMPLES], now);
+        }
+        assert_eq!(queue.stats().queued, 4);
+        assert_eq!(queue.stats().dropped, 6);
+        let frame = queue.take(now, Duration::from_millis(60)).unwrap();
+        assert_eq!(frame.samples[0], 6);
+        assert!(frame.discontinuity);
+        assert!(queue.take(now + Duration::from_secs(1), Duration::from_millis(60)).is_none());
+        assert_eq!(queue.stats().stale, 3);
+        queue.closed.store(true, Ordering::Release);
+        queue.push(&[1; FRESH_AUDIO_SAMPLES], now);
+        assert_eq!(queue.stats().received, 10);
+        assert!(queue.take(now, Duration::from_secs(1)).is_none());
+    }
+
+    #[test]
+    fn callback_drops_on_contention_without_waiting() {
+        let queue = FreshAudioQueue::new();
+        let guard = queue.try_state().unwrap();
+        queue.push(&[1; FRESH_AUDIO_SAMPLES], Instant::now());
+        assert_eq!(queue.stats().dropped, 1);
+        assert!(queue.take(Instant::now(), Duration::from_millis(60)).is_none());
+        drop(guard);
+        queue.push(&[2; FRESH_AUDIO_SAMPLES], Instant::now());
+        assert!(queue.take(Instant::now(), Duration::from_millis(60)).unwrap().discontinuity);
+    }
+
+    #[test]
+    fn slow_native_callback_does_not_refresh_decoded_age() {
+        use sys_at::AudioSink;
+
+        let queue = FreshAudioQueue::new();
+        for _ in 0..100 {
+            // Inject the elapsed conversion/callback time supplied by the native
+            // bridge, independently of time spent waiting in the reader queue.
+            queue.on_data_with_age(&[1; FRESH_AUDIO_SAMPLES], 48_000, 2, 480, 250_000);
+            assert!(queue.take(Instant::now(), Duration::from_millis(60)).is_none());
+        }
+        assert_eq!(queue.stats().stale, 100);
+        assert_eq!(queue.stats().queued, 0);
+        queue.on_data_with_age(&[2; FRESH_AUDIO_SAMPLES], 48_000, 2, 480, 0);
+        let recovered = queue.take(Instant::now(), Duration::from_secs(1)).unwrap();
+        assert_eq!(recovered.samples[0], 2);
+        assert!(recovered.discontinuity);
+    }
+
+    #[test]
+    fn concurrent_frames_are_owned_and_ordered() {
+        let queue = Arc::new(FreshAudioQueue::new());
+        let done = Arc::new(AtomicBool::new(false));
+        let now = Instant::now();
+        let producer_queue = queue.clone();
+        let producer_done = done.clone();
+        let producer = std::thread::spawn(move || {
+            for sequence in 1..=100_000u64 {
+                producer_queue.push(&[(sequence % 30_000) as i16; FRESH_AUDIO_SAMPLES], now);
+            }
+            producer_done.store(true, Ordering::Release);
+        });
+        let mut last_sequence = 0;
+        let mut torn = false;
+        while !done.load(Ordering::Acquire) || queue.stats().queued != 0 {
+            if let Some(frame) = queue.take(now, Duration::from_secs(1)) {
+                torn |= frame.sequence <= last_sequence;
+                torn |=
+                    frame.samples.iter().any(|sample| *sample != (frame.sequence % 30_000) as i16);
+                last_sequence = frame.sequence;
+            } else {
+                std::thread::yield_now();
+            }
+        }
+        producer.join().unwrap();
+        assert!(!torn);
+        assert!(last_sequence != 0);
+        assert_eq!(queue.stats().received, 100_000);
+        assert_eq!(queue.stats().queued, 0);
+    }
+}
