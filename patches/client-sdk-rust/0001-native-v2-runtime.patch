+    /// Process one fixed 48 kHz mono frame without constructing an error string.
+    pub fn process_10ms(&mut self, data: &mut [i16; 480], reverse: bool) -> i32 {
+        // SAFETY: The fixed array is aligned, valid for 480 i16 samples, and
+        // exclusively borrowed. WebRTC supports in-place processing.
+        unsafe {
+            if reverse {
+                self.sys_handle.pin_mut().process_reverse_stream(
+                    data.as_ptr(),
+                    480,
+                    data.as_mut_ptr(),
+                    480,
+                    48_000,
+                    1,
+                )
+            } else {
+                self.sys_handle.pin_mut().process_stream(
+                    data.as_ptr(),
+                    480,
+                    data.as_mut_ptr(),
+                    480,
+                    48_000,
+                    1,
+                )
+            }
+        }
+    }
+
+    /// Set the fixed-frame processor delay without allocating an error value.
+    pub fn set_realtime_delay_ms(&mut self, delay_ms: i32) -> i32 {
+        self.sys_handle.pin_mut().set_stream_delay_ms(delay_ms)
+    }
