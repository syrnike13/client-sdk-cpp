+    /// Captures one externally encoded H.264 access unit.
+    ///
+    /// # Safety
+    /// `capture.data_ptr` must point to `capture.data_size` readable bytes for
+    /// the duration of this call.
+    pub unsafe fn capture_encoded_frame(
+        &self,
+        capture: proto::CaptureEncodedVideoFrameRequest,
+    ) -> FfiResult<bool> {
+        if self.source_type != proto::VideoSourceType::VideoSourceNativeEncoded {
+            return Err(FfiError::InvalidRequest("video source is not pre-encoded".into()));
+        }
+        let size = usize::try_from(capture.data_size)
+            .map_err(|_| FfiError::InvalidRequest("encoded frame size is invalid".into()))?;
+        if capture.data_ptr == 0 || size == 0 || size > MAX_ENCODED_ACCESS_UNIT_BYTES {
+            return Err(FfiError::InvalidRequest("encoded frame payload is invalid".into()));
+        }
+        let payload = std::slice::from_raw_parts(capture.data_ptr as *const u8, size);
+        match self.source {
+            #[cfg(not(target_arch = "wasm32"))]
+            RtcVideoSource::Native(ref source) => {
+                let resolution = source.video_resolution();
+                let accepted = source.capture_encoded_frame(&EncodedVideoFrame {
+                    codec: EncodedVideoCodec::H264,
+                    payload,
+                    timestamp_us: capture.timestamp_us,
+                    frame_type: if capture.key_frame {
+                        EncodedFrameType::Key
+                    } else {
+                        EncodedFrameType::Delta
+                    },
+                    resolution,
+                    frame_metadata: frame_metadata_from_proto(capture.metadata),
+                });
+                Ok(accepted)
+            }
+            _ => Err(FfiError::InvalidRequest("unsupported video source type".into())),
+        }
+    }
