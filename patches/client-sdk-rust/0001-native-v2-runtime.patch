+#pragma once
+
+#include <cstdint>
+
+namespace livekit {
+
+// Encoder-queue drops are safe for raw frames, but break pre-encoded
+// references. This state belongs to one pass-through encoder, not the shared
+// capture source.
+class EncodedReferenceContinuity {
+ public:
+  [[nodiscard]] bool admit(std::uint64_t sequence, bool keyframe) noexcept {
+    if (sequence == 0 || sequence <= last_sequence_) {
+      waiting_for_keyframe_ = true;
+      return false;
+    }
+    const bool consecutive = sequence - last_sequence_ == 1;
+    last_sequence_ = sequence;
+    if (keyframe) {
+      waiting_for_keyframe_ = false;
+      return true;
+    }
+    if (!consecutive)
+      waiting_for_keyframe_ = true;
+    return !waiting_for_keyframe_;
+  }
+
+  void invalidate() noexcept { waiting_for_keyframe_ = true; }
+
+ private:
+  std::uint64_t last_sequence_ = 0;
+  bool waiting_for_keyframe_ = true;
+};
+
+}  // namespace livekit
