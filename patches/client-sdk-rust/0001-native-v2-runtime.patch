+        if self.source_type != proto::VideoSourceType::VideoSourceNativeEncoded {
+            return Err(FfiError::InvalidRequest("video source is not pre-encoded".into()));
+        }
+        match self.source {
+            #[cfg(not(target_arch = "wasm32"))]
+            RtcVideoSource::Native(ref source) => Ok(source.take_keyframe_request()),
+            _ => Err(FfiError::InvalidRequest("unsupported video source type".into())),
+        }
+    }
+
+    /// Consume the latest pre-encoded sender bitrate allocation, if changed.
+    pub(crate) fn take_bitrate_request(&self) -> FfiResult<Option<u64>> {
+        if self.source_type != proto::VideoSourceType::VideoSourceNativeEncoded {
+            return Err(FfiError::InvalidRequest("video source is not pre-encoded".into()));
+        }
+        match self.source {
+            #[cfg(not(target_arch = "wasm32"))]
+            RtcVideoSource::Native(ref source) => {
+                Ok(source.take_rate_control_request().map(|value| value.target_bitrate_bps))
+            }
+            _ => Err(FfiError::InvalidRequest("unsupported video source type".into())),
+        }
