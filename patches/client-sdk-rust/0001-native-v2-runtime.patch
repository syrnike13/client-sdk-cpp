+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//! Private fixed-frame native ABI. The public C++ class owns these pointers;
+//! no per-frame protobuf allocation, asynchronous dispatch, or handle lookup.
+
+use livekit::webrtc::{
+    native::fresh_audio_stream::{FreshAudioStream, FRESH_AUDIO_SAMPLES},
+    prelude::MediaStreamTrack,
+};
+use std::{ffi::c_void, panic, ptr, time::Duration};
+
+use crate::{server::room::FfiTrack, FFI_SERVER};
+
+#[repr(C)]
+/// Private C ABI result containing frame age and bounded ingress counters.
+pub struct FreshAudioInfo {
+    sequence: u64,
+    age_us: u64,
+    received: u64,
+    dropped: u64,
+    stale: u64,
+    invalid: u64,
+    queued: u64,
+    discontinuity: u32,
+}
+
+/// Create a sink for a live audio track. Returns null for invalid/non-audio IDs.
+#[no_mangle]
+pub extern "C" fn livekit_ffi_fresh_audio_create(track_handle: u64) -> *mut c_void {
+    panic::catch_unwind(|| {
+        let Ok(track) = FFI_SERVER.retrieve_handle::<FfiTrack>(track_handle) else {
+            return ptr::null_mut();
+        };
+        let MediaStreamTrack::Audio(audio) = track.track.rtc_track() else {
+            return ptr::null_mut();
+        };
+        Box::into_raw(Box::new(FreshAudioStream::new(audio))).cast()
+    })
+    .unwrap_or(ptr::null_mut())
+}
+
+/// # Safety
+/// Handle is null or the exclusively owned live create result. Call once,
+/// after all reads, and before Room/SDK destruction. No concurrent calls.
+#[no_mangle]
+pub unsafe extern "C" fn livekit_ffi_fresh_audio_destroy(handle: *mut c_void) {
+    if !handle.is_null() {
+        // SAFETY: The public owner returns exclusive ownership once.
+        drop(unsafe { Box::from_raw(handle.cast::<FreshAudioStream>()) });
+    }
+}
+
+/// Return 1 for a frame, 0 for empty/contention/stale, -1 for invalid arguments.
+/// Stats are returned even when the queue is empty; PCM is untouched then.
+///
+/// # Safety
+/// Handle is a live create result. Samples is a writable array of exactly 960
+/// i16, info is a writable FreshAudioInfo; both are aligned and do not alias the
+/// handle or each other. One owner serializes reads/destruction.
+#[no_mangle]
+pub unsafe extern "C" fn livekit_ffi_fresh_audio_read(
+    handle: *mut c_void,
+    samples: *mut i16,
+    sample_count: usize,
+    maximum_age_us: u64,
+    info: *mut FreshAudioInfo,
+) -> i32 {
+    if handle.is_null()
+        || samples.is_null()
+        || info.is_null()
+        || sample_count != FRESH_AUDIO_SAMPLES
+        || maximum_age_us == 0
+        || maximum_age_us > 1_000_000
+    {
+        return -1;
+    }
+    // SAFETY: All pointers follow the documented exclusive storage contract.
+    let stream = unsafe { &*handle.cast::<FreshAudioStream>() };
+    let frame = stream.try_read(Duration::from_micros(maximum_age_us));
+    let stats = stream.stats();
+    // SAFETY: The caller supplies exclusive writable, aligned result storage.
+    let output = unsafe { &mut *info };
+    *output = FreshAudioInfo {
+        sequence: 0,
+        age_us: 0,
+        received: stats.received,
+        dropped: stats.dropped,
+        stale: stats.stale,
+        invalid: stats.invalid,
+        queued: stats.queued,
+        discontinuity: 0,
+    };
+    if let Some(frame) = frame {
+        output.sequence = frame.sequence;
+        output.age_us = frame.decoded_at.elapsed().as_micros().min(u64::MAX as u128) as u64;
+        output.discontinuity = u32::from(frame.discontinuity);
+        // SAFETY: The stack frame and caller's 960-sample output do not overlap.
+        unsafe { ptr::copy_nonoverlapping(frame.samples.as_ptr(), samples, FRESH_AUDIO_SAMPLES) };
+        return 1;
+    }
+    0
+}
