+struct PublishedTransceiver {
+    transceiver: RtpTransceiver,
+    reuse_key: TransceiverReuseKey,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+struct TransceiverReuseKey {
+    video: bool,
+    encoding_rids: Vec<String>,
+}
+
+fn restore_transceiver(
+    transceiver: &RtpTransceiver,
+    track: &LocalTrack,
+    encodings: &[RtpEncodingParameters],
+) -> bool {
+    let sender = transceiver.sender();
+
+    if !encodings.is_empty() {
+        let mut parameters = sender.parameters();
+        if parameters.encodings.len() != encodings.len() {
+            log::warn!(
+                "cannot reuse RTP transceiver: encoding count changed from {} to {}",
+                parameters.encodings.len(),
+                encodings.len()
+            );
+            return false;
+        }
+
+        for (current, requested) in parameters.encodings.iter_mut().zip(encodings) {
+            current.active = requested.active;
+            current.max_bitrate = requested.max_bitrate;
+            current.max_framerate = requested.max_framerate;
+            current.priority = requested.priority;
+            current.scale_resolution_down_by = requested.scale_resolution_down_by;
+            current.scalability_mode.clone_from(&requested.scalability_mode);
+        }
+
+        if let Err(error) = sender.set_parameters(parameters) {
+            log::warn!("failed to restore RTP encoding parameters: {error:?}");
+            return false;
+        }
+    }
+
+    if let Err(error) = sender.set_track(Some(track.rtc_track())) {
+        log::warn!("failed to restore track on reusable RTP sender: {error:?}");
+        return false;
+    }
+    if let Err(error) = transceiver.set_direction(RtpTransceiverDirection::SendOnly) {
+        log::warn!("failed to restore reusable RTP transceiver direction: {error:?}");
+        return false;
+    }
+
+    true
+}
