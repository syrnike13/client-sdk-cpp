+//! Fixed-frame, exclusively owned microphone DSP seam. This has no FFI server
+//! handle table, protobuf, mutex, event, callback or asynchronous operation.
+
+use livekit::webrtc::native::apm::AudioProcessingModule;
+use std::{ffi::c_void, mem::align_of, panic, ptr};
+
+struct RealtimeApm {
+    echo: AudioProcessingModule,
+    noise: AudioProcessingModule,
+}
+
+/// Allocate and prewarm the two independent processors on their future owner.
+#[no_mangle]
+pub extern "C" fn livekit_ffi_realtime_apm_create() -> *mut c_void {
+    panic::catch_unwind(|| {
+        let mut apm = Box::new(RealtimeApm {
+            echo: AudioProcessingModule::new(true, false, false, false),
+            noise: AudioProcessingModule::new(false, false, false, true),
+        });
+        let mut reference = [0i16; 480];
+        let mut microphone = [0i16; 480];
+        let mut seed = 1u32;
+        for _ in 0..200 {
+            for sample in &mut reference {
+                seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+                *sample = ((seed >> 20) as i16) - 2048;
+            }
+            microphone.copy_from_slice(&reference);
+            if apm.echo.set_realtime_delay_ms(0) != 0
+                || apm.echo.process_10ms(&mut reference, true) != 0
+                || apm.echo.process_10ms(&mut microphone, false) != 0
+                || apm.noise.process_10ms(&mut microphone, false) != 0
+            {
+                return ptr::null_mut();
+            }
+        }
+        Box::into_raw(apm).cast()
+    })
+    .unwrap_or(ptr::null_mut())
+}
+
+/// Release a processor on the same owner after all processing calls finish.
+///
+/// # Safety
+/// `handle` must be null or a live pointer returned by create, consumed exactly
+/// once. It must not be accessed concurrently or after this call.
+#[no_mangle]
+pub unsafe extern "C" fn livekit_ffi_realtime_apm_destroy(handle: *mut c_void) {
+    if !handle.is_null() {
+        // SAFETY: Exclusive ownership is returned under the documented contract.
+        drop(unsafe { Box::from_raw(handle.cast::<RealtimeApm>()) });
+    }
+}
+
+/// Process one 48 kHz mono/10 ms frame. Returns 0=ok, 1=invalid input, 2=DSP failure.
+///
+/// # Safety
+/// `handle` is a live, exclusively accessed create result. `microphone` points
+/// to exactly 480 writable i16 samples. `reference` is null or 480 readable i16
+/// samples. All storage remains valid for this synchronous call.
+#[no_mangle]
+pub unsafe extern "C" fn livekit_ffi_realtime_apm_process(
+    handle: *mut c_void,
+    microphone: *mut i16,
+    samples: usize,
+    reference: *const i16,
+    delay_ms: u32,
+    noise_suppression: bool,
+    echo_cancellation: bool,
+) -> i32 {
+    if handle.is_null()
+        || microphone.is_null()
+        || samples != 480
+        || microphone as usize % align_of::<i16>() != 0
+        || reference as usize % align_of::<i16>() != 0
+        || delay_ms > 500
+    {
+        return 1;
+    }
+    let mut reverse = [0i16; 480];
+    if !reference.is_null() {
+        // SAFETY: Caller guarantees the 480 samples. Copy before borrowing the
+        // microphone, allowing callers to use the same storage without aliasing.
+        unsafe { ptr::copy_nonoverlapping(reference, reverse.as_mut_ptr(), 480) };
+    }
+    // SAFETY: Validated dimensions/alignment and exclusive caller-owned storage.
+    let apm = unsafe { &mut *handle.cast::<RealtimeApm>() };
+    // SAFETY: The caller supplies exactly one writable fixed frame.
+    let microphone = unsafe { &mut *microphone.cast::<[i16; 480]>() };
+    if echo_cancellation && !reference.is_null() {
+        if apm.echo.set_realtime_delay_ms(delay_ms as i32) != 0
+            || apm.echo.process_10ms(&mut reverse, true) != 0
+            || apm.echo.process_10ms(microphone, false) != 0
+        {
+            return 2;
+        }
+    }
+    if noise_suppression && apm.noise.process_10ms(microphone, false) != 0 {
+        return 2;
+    }
+    0
+}
